  "constitutionalGates": {
    "description": "14 immutable gates per ADR-2605261200. Changes require Council Lv6+ supermajority + new ADR.",
    "gates": {
      "G1": "HPDC clamping force ≤6000 ton in R0..R3; giga press class (≥7500 ton) = N1 post-R3 deferral",
      "G2": "Aluminum-silicon alloy only; composition fully disclosed (5-element baseline + trace改質剤). No proprietary closed alloys.",
      "G3": "All process parameters open-source Apache 2.0 + Charter Rider: injection profile, die thermal management, gate velocity, vacuum-assist pressure",
      "G4": "Witness quorum ≥2 robot signers (Mimi metrology + Otete handling) per partAttestation; Ed25519 DID-bound",
      "G5": "Bilingual (JA + EN) SOPs / safety / emergency procedures for all melt + injection + post-process steps",
      "G6": "Charter Rider §2(a) clearance — no military vehicle / aerospace fuselage / armor / firearms structural parts",
      "G7": "Alloy 5-element baseline (Al + Si 6-12% + Mg ≤0.5% + Mn ≤0.7% + Fe ≤1.0%) + trace改質剤 (Sr ≤0.05% + Ti ≤0.2%). No Be / Pb / Cd / Hg / radioactive. No OPCW Schedule compounds in raw materials or die release agents. G7=NONE wave (yakushi Wave 1c parity)",
      "G8": "Shot replay determinism — full injection profile @ 1 kHz (position + velocity + pressure + temp) + WASM state-machine sealed",
      "G9": "Induction + electric resistance melting only. No fossil-fired furnace. Energy budget ≤4 kWh/kg cast R3",
      "G10": "Aluminum scrap recovery ≥95% (sprue + runner + reject + chip + die-spray residue) tracked in partAttestation.materialBalance",
      "G11": "Personnel vetting: Adherent SBT + 危険物取扱主任者-equivalent for >500 ton operations; operator DID bound to per-shot record",
      "G12": "Production rate ≤1 large part / 90 sec R3 (Wellbecoming + anti-Taylorism, yakushi G11 + wadachi G11 parity)",
      "G13": "Murakumo mesh placement declared 30 days prior + 1 km community feedback period (HPDC noise + vibration)",
      "G14": "partAttestation includes full lineage CIDs (alloy + die + shot + QC + HT + machining) + IPFS-pinned final part photo + material balance log"
    }
  },
  "nonGoals": {
    "description": "10 explicitly excluded scopes (deferred or constitutional NEVER)",
    "goals": {
      "N1": "Giga press class (≥7500 ton clamping force) — post-R3 + Council Lv6+ supermajority (silicon EUV parity, ADR-2605242545)",
      "N2": "Military vehicle structural / aerospace fuselage / armor plate / hull plating — NEVER (Charter Rider §2(a) constitutional)",
      "N3": "Firearms / ammunition / shell casing / projectile body structural — NEVER (§2(a))",
      "N4": "Nuclear containment Class 1/2/3 RPV / primary loop pressure boundary — NEVER (radiological + §2(c))",
      "N5": "Hazmat pressure-vessel structural (LPG/CNG/H₂/chemical reactor) — kuni-umi-S6 chemistry carve-out, ADR separate",
      "N6": "Proprietary alloy 'secret sauce' composition — NEVER (G2 + G3 constitutional, §2(e))",
      "N7": "Human-occupied vehicle structural certification (R0..R2 prohibited; R3 = Council Lv6+ audit only)",
      "N8": "Mass-market consumer for external commercial sale — SBT↔SBT internal carve-out only (ADR-2605192115 §3)",
      "N9": "Fossil-fired melting (gas reverberatory, oil burner) — NEVER (G9 invariant)",
      "N10": "State defense budget subsidy / military procurement contract — NEVER (§2(a) + §2(i) constitutional)"
    }
  },
